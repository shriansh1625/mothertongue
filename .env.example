# Copy to .env.local and fill in. Never commit .env.local.

# --- PayPal (SANDBOX) ---
# developer.paypal.com > Apps & Credentials (Sandbox) > your app (linked to a US business sandbox account)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook ID from the app's Webhooks section (enables signature verification)
PAYPAL_WEBHOOK_ID=
# sandbox (default) or live
PAYPAL_ENV=sandbox

# --- AI (all on Groq, one key: console.groq.com) ---
# whisper-large-v3-turbo = speech-to-text, openai/gpt-oss-120b = campaign designer + settlement agent,
# qwen/qwen3.8-27b = multilingual clip judge (openai/gpt-oss-20b fallback)
GROQ_API_KEY=
# Optional model overrides
# GROQ_DESIGN_MODEL=openai/gpt-oss-120b
# GROQ_JUDGE_MODEL=qwen/qwen3.8-27b
# GROQ_FALLBACK_JUDGE_MODEL=openai/gpt-oss-20b
# GROQ_STT_MODEL=whisper-large-v3-turbo

# --- App ---
# Public base URL (used for PayPal return/cancel URLs). Local: http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Where the SQLite database lives (Render: mount a disk at /var/data)
DATA_DIR=./data
# Auto-settle a speaker once their verified, unpaid earnings reach this many cents (0 = manual only)
SETTLE_THRESHOLD_CENTS=100
