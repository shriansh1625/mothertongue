# Copy to .env.local and fill in. Never commit .env.local.

# --- PayPal (SANDBOX) ---
# developer.paypal.com > Apps & Credentials (Sandbox) > your app (linked to a US business sandbox account)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook ID from the app's Webhooks section (enables signature verification)
PAYPAL_WEBHOOK_ID=
# sandbox (default) or live
PAYPAL_ENV=sandbox

# --- AI ---
# Claude does the reasoning: campaign design, clip judging, settlement review
ANTHROPIC_API_KEY=
# Groq Whisper does speech-to-text (console.groq.com)
GROQ_API_KEY=

# --- App ---
# Public base URL (used for PayPal return/cancel URLs). Local: http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Where the SQLite database lives (Render: mount a disk at /var/data)
DATA_DIR=./data
# Auto-settle a speaker once their verified, unpaid earnings reach this many cents (0 = manual only)
SETTLE_THRESHOLD_CENTS=100
